Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Reference Frame: prius/odom
      
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic: /prius/base_scan
      Size: 0.05
      Color: 255; 0; 0
      
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic: /prius/map
      Color Scheme: map
      
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic: /prius/robot_description
      
  Global Options:
    Fixed Frame: prius/odom
    
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0